{
  "name": "registro-llamadas",
  "version": "2.0.0",
  "private": true,
  "description": "Registro de llamadas con Prisma + Supabase",
  "main": "src/servidor.js",
  "scripts": {
    "start": "node src/servidor.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "importar-sqlite": "node scripts/importar-sqlite.js",
    "importar-censo": "node scripts/importar-censo.js",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate",
    "db:rls": "prisma db execute --file prisma/rls.sql --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "engines": {
    "node": "22.x"
  }
}
